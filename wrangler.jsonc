{
  "name": "cheerbook-submissions",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cheerbook.kozueginko.com/api/submissions*", "zone_name": "kozueginko.com" }
  ],
  "ratelimits": [
    { "name": "SUBMISSION_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "keep_vars": true
}
